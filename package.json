{
  "name": "bricks-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BRICKS Design System Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/showcase",
    "build": "npm run build --workspace=apps/showcase",
    "build:bricks": "npm run build --workspace=packages/bricks",
    "storybook": "npm run storybook --workspace=packages/bricks",
    "build-storybook": "npm run build-storybook --workspace=packages/bricks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anerjin/private_project_design_system.git"
  },
  "license": "MIT"
}
