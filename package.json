{
  "name": "bricks-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DOI INC Design System Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspace=packages/bricks",
    "build:bricks": "npm run build --workspace=packages/bricks",
    "build:all": "npm run build:all --workspace=packages/bricks",
    "storybook": "npm run storybook --workspace=packages/bricks",
    "build-storybook": "npm run build-storybook --workspace=packages/bricks",
    "gallery": "npm run dev --workspace=apps/gallery",
    "build:gallery": "npm run build --workspace=apps/gallery"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anerjin/private_project_design_system.git"
  },
  "license": "MIT"
}
