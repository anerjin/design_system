{
  "name": "@bricks/core",
  "version": "1.0.0",
  "type": "module",
  "description": "BRICKS - Simple text-based design system with dark/light mode",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist/bundle",
    "core/styles",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle/bricks.es.js",
      "require": "./dist/bundle/bricks.umd.js"
    },
    "./styles": "./core/styles/bundle.css",
    "./styles/bundle": "./core/styles/bundle.built.css",
    "./styles/bundle.min": "./core/styles/bundle.min.css",
    "./styles/*": "./core/styles/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "build:css": "node scripts/build-css.js --minify",
    "build:js": "node scripts/build-js.js",
    "build:bundle": "npm run build:css && npm run build:js",
    "build:all": "npm run build && npm run build:bundle",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-links": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "boxicons": "^2.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.1.11",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
