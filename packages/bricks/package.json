{
  "name": "@bricks/core",
  "version": "2.0.0",
  "type": "module",
  "description": "DOI INC - React design system built on Tailwind CSS v4 + daisyUI v5",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "INTERACTIVE_COMPONENTS.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./bundle": "./dist/bricks.umd.js",
    "./styles": "./dist/bricks.css",
    "./styles/min": "./dist/bricks.min.css",
    "./styles/tokens": "./dist/bricks-tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "build:css": "node scripts/build-css.js",
    "build:js": "node scripts/build-js.js",
    "build:bundle": "npm run build:css && npm run build:js",
    "build:all": "npm run build && npm run build:bundle",
    "typecheck": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build:all",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:legacy-icons": "node scripts/build-legacy-icons.cjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-links": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "daisyui": "^5.7.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.1.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "chart.js": "^4.5.1",
    "lucide-react": "^1.42.0",
    "react-resizable-panels": "^4.12.4"
  }
}
