{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // 배포물을 만드는 설정이므로 base의 noEmit을 되돌린다
    "noEmit": false,
    "outDir": "dist",
    // JS는 Vite가 번들로 만든다. tsc는 타입 선언만 내보낸다.
    //
    // tsc가 파일별 JS를 내보내면 `export * from './react'`가 확장자 없이 그대로
    // 남아 Node ESM에서 해석되지 않는다(ERR_UNSUPPORTED_DIR_IMPORT).
    // 번들 하나로 내보내면 이 문제가 아예 생기지 않는다.
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/react/**/*",
    "src/index.ts"
  ],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/*.test.tsx"
  ]
}
